# ═══════════════════════════════════════════════════════════════════════════
# AI Inference Provider Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Forge NPS supports any OpenAI-compatible API endpoint.
# Pick ONE primary provider and comment out the others.

# ── Option A: Nous Research Portal (RECOMMENDED) ──
# https://portal.nousresearch.com | Bearer token auth
NOUS_ENDPOINT=https://inference-api.nousresearch.com/v1/chat/completions
NOUS_API_KEY=your_nous_api_key_here

# ── Option B: Moonshot AI (Kimi) native API ──
# https://platform.moonshot.cn
# KIMI_ENDPOINT=https://api.moonshot.cn/v1/chat/completions
# KIMI_API_KEY=your_moonshot_api_key_here

# ── Option C: NVIDIA NIM ──
# https://build.nvidia.com
# NIM_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
# KIMI_API_KEY=your_nvapi_key_here

# ── Option D: OpenRouter (proxy to 200+ models) ──
# https://openrouter.ai
# OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_API_KEY=your_openrouter_key_here

# ═══════════════════════════════════════════════════════════════════════════
# Model Names
# ═══════════════════════════════════════════════════════════════════════════
# Moonshot Kimi models via Nous Research Portal (OpenRouter-style IDs):
#   - ~moonshotai/kimi-latest      (default, always up to date)
#   - ~moonshotai/kimi-k2.6        (highest quality)
#   - ~moonshotai/kimi-k2          (balanced)
#   - ~moonshotai/kimi-k2-thinking (reasoning mode)
DIRECTOR_MODEL=~moonshotai/kimi-latest
THINKING_MODEL=~moonshotai/kimi-latest
VISION_MODEL=~moonshotai/kimi-latest

# Legacy aliases (kept for backward compatibility):
KIMI_INSTRUCT_MODEL=~moonshotai/kimi-latest
KIMI_THINKING_MODEL=~moonshotai/kimi-latest
KIMI_VISUAL_MODEL=~moonshotai/kimi-latest
COMFYUI_PRIMARY=http://100.112.87.8:8188
COMFYUI_SECONDARY=http://100.112.87.8:8189
DASHBOARD_PORT=7000
MOCK_MODE=false

# LM Studio local inference fallback
LMSTUDIO_HOST=http://localhost:1234
LMSTUDIO_CHAT_MODEL=qwen2.5-3b-instruct
LMSTUDIO_VISION_MODEL=qwen3.6-35b-a3b
LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
USE_LOCAL_MODELS=false
