# Language model — any OpenAI-compatible endpoint (local or frontier)
# Examples:
#   LM Studio / vLLM / Ollama:  http://localhost:1234/v1
#   OpenRouter:                 https://openrouter.ai/api/v1
#   OpenAI:                     https://api.openai.com/v1
#   Nous Portal:                https://inference-api.nousresearch.com/v1
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=your-local-or-frontier-model
# LLM_API_KEY=
# LLM_BACKEND=local

# Optional aliases (same slot — pick one stack)
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1
# NOUS_API_KEY=
# NOUS_ENDPOINT=https://inference-api.nousresearch.com/v1/chat/completions
DIRECTOR_MODEL=

# Spark / ComfyUI (images + video)
COMFYUI_PRIMARY=http://localhost:8188
COMFYUI_SECONDARY=http://localhost:8189

# Optional second local chat host (same as LLM_BASE_URL if you use LM Studio)
LMSTUDIO_HOST=http://localhost:1234
LMSTUDIO_PORT=1234
LMSTUDIO_CHAT_MODEL=
LMSTUDIO_VISION_MODEL=

DASHBOARD_PORT=7000
MOCK_MODE=false

# Media + Hermes isolation (do not use ~/.hermes)
# CINESMITH_MEDIA_ROOT=
# CINESMITH_ALLOW_GLOBAL_HERMES=1
#
# Launch: bash scripts/launch_cinesmith.sh
# Produce UI: http://127.0.0.1:7000
# Previous studio: http://127.0.0.1:7000/studio
