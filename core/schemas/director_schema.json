{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Forge Director Schema",
    "description": "Structured instructions generated by Kimi to control visual and audio sub-agents.",
    "type": "object",
    "properties": {
        "production_metadata": {
            "type": "object",
            "properties": {
                "project_title": {
                    "type": "string"
                },
                "overall_mood": {
                    "type": "string"
                },
                "narrative_reasoning_trace": {
                    "type": "string"
                },
                "consistency_anchors": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "anchor_id": {
                                "type": "string"
                            },
                            "constraint": {
                                "type": "string"
                            },
                            "applies_to_shots": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        },
                        "required": [
                            "anchor_id",
                            "constraint",
                            "applies_to_shots"
                        ]
                    }
                },
                "visual_style_guide": {
                    "type": "object",
                    "properties": {
                        "color_palette": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "lighting_profile": {
                            "type": "string"
                        },
                        "texture_descriptors": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "required": [
                        "color_palette",
                        "lighting_profile"
                    ]
                }
            },
            "required": [
                "project_title",
                "overall_mood"
            ]
        },
        "shot_list": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "shot_id": {
                        "type": "string"
                    },
                    "sequence_order": {
                        "type": "integer"
                    },
                    "reasoning_trace": {
                        "type": "string"
                    },
                    "predicted_failure_modes": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "failure_type": {
                                    "type": "string",
                                    "enum": [
                                        "Photometric",
                                        "Anatomical",
                                        "Temporal",
                                        "Semantic"
                                    ]
                                },
                                "risk_level": {
                                    "type": "string",
                                    "enum": [
                                        "low",
                                        "medium",
                                        "high"
                                    ]
                                },
                                "mitigation": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "failure_type",
                                "risk_level",
                                "mitigation"
                            ]
                        }
                    },
                    "visual_prompt": {
                        "type": "object",
                        "properties": {
                            "subject": {
                                "type": "string"
                            },
                            "action": {
                                "type": "string"
                            },
                            "environment": {
                                "type": "string"
                            },
                            "camera": {
                                "type": "object",
                                "properties": {
                                    "movement": {
                                        "type": "string",
                                        "enum": [
                                            "static",
                                            "pan",
                                            "tilt",
                                            "dolly",
                                            "truck",
                                            "crane",
                                            "zoom"
                                        ]
                                    },
                                    "speed": {
                                        "type": "string"
                                    },
                                    "altitude": {
                                        "type": "string"
                                    },
                                    "angle": {
                                        "type": "string"
                                    }
                                }
                            },
                            "lens_specs": {
                                "type": "object",
                                "properties": {
                                    "focal_length": {
                                        "type": "string"
                                    },
                                    "depth_of_field": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "required": [
                            "subject",
                            "action",
                            "environment"
                        ]
                    },
                    "audio_directive": {
                        "type": "object",
                        "properties": {
                            "music_style": {
                                "type": "string"
                            },
                            "tempo": {
                                "type": "string"
                            },
                            "sfx_elements": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "ambient_soundscape": {
                                "type": "string"
                            }
                        }
                    }
                },
                "required": [
                    "shot_id",
                    "sequence_order",
                    "visual_prompt"
                ]
            }
        }
    },
    "required": [
        "production_metadata",
        "shot_list"
    ]
}