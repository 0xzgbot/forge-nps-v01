{
  "prompt": {
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "photorealistic portrait of a person, high detail, 8k",
        "clip": ["10", 1]
      }
    },
    "10": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "flux1-dev.safetensors"
      }
    },
    "X": {
      "class_type": "FluxReduxImageEncoder",
      "inputs": {
        "image": "reference_uploaded.png",
        "type": "flux"
      }
    },
    "Y": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1024,
        "height": 576,
        "batch_size": 1
      }
    },
    "Z": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 42,
        "steps": 20,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0,
        "model": ["model_loader", 0],
        "positive": ["6", 0],
        "negative": ["neg_clip", 0],
        "latent_image": ["Y", 0]
      }
    },
    "model_loader": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "flux1-dev.safetensors"
      }
    },
    "neg_clip": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "blurry, low quality, distorted",
        "clip": ["10", 1]
      }
    },
    "save_image": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "flux_redux_out",
        "images": ["Z", 0]
      }
    }
  }
}
